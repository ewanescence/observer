# HTTP listener inside the container
OBSERVER_LISTEN_ADDR=:8080

# SQLite database path inside /data volume
OBSERVER_DB_PATH=/data/observer.db

# Optional 32-byte encryption key (64 hex chars or base64) to encrypt stored
# HMAC secrets, API keys, and PGP private keys at rest in SQLite.
# Generate with: openssl rand -hex 32
OBSERVER_MASTER_KEY=

# Require Autentico ForwardAuth identity header (X-Auth-User) on / and /api/*
OBSERVER_TRUST_FORWARD_AUTH=true

# Optional comma-separated allowlist of Autentico user IDs or verified emails
OBSERVER_ALLOWED_USERS=

# Optional Autentico ForwardAuth App ID (used to enable the Sign out button at /_autentico/<id>/logout)
OBSERVER_AUTENTICO_APP_ID=

# Or specify the full logout path directly (overrides OBSERVER_AUTENTICO_APP_ID)
OBSERVER_AUTENTICO_LOGOUT_PATH=

# Default data retention (days) and background cleanup interval
OBSERVER_RETENTION_DAYS=30
OBSERVER_HEARTBEAT_RETENTION_DAYS=1
OBSERVER_RETENTION_INTERVAL=1h

# Request body limit (10 MiB) and decompressed payload limit (50 MiB)
OBSERVER_MAX_BODY_BYTES=10485760
OBSERVER_MAX_DECOMPRESSED_BYTES=52428800

# External Docker network shared with Caddy / Autentico
PROXY_NETWORK=caddy
